print("Q7 - PERFORMANCE REDESIGN")
print("=" * 60)

def original_plus(items):
    result = ""
    for item in items:
        result += item + ";"
    return result

def redesigned_join(items):
    return ";".join(items) + ";"

def measure(func, items):
    times = []
    result = ""
    for _ in range(3):
        start = time.perf_counter()
        result = func(items)
        times.append(time.perf_counter() - start)
    return result, mean(times)

for n in (1000, 10000, 200000):
    items = [f"Item{i}:Rs{i % 50}" for i in range(n)]

    old_output, old_time = measure(original_plus, items)
    new_output, new_time = measure(redesigned_join, items)

    print("\nItems:", n)
    print("Same output:", old_output == new_output)
    print("Original average:", round(old_time, 5), "sec")
    print("Redesigned average:", round(new_time, 5), "sec")

    if new_time > 0:
        print("Speed-up:", round(old_time/new_time, 2), "x")

