def normalize(text):
    return text.strip().replace(" ", "").replace("-", "").upper()

def valid(reg):
    if len(reg) not in (9, 10):
        return False
    if not reg[:2].isalpha() or not reg[2:4].isdigit():
        return False
    series = reg[4:-4]
    return series.isalpha() and reg[-4:].isdigit()

samples = [
    "tn 09 ab 1234",
    "KA-01-M-0007",
    "TN9AB1234",
    "TN 22 1234 AB",
    "mh 12 x 9876",
    "AP-39-CD-4567"
]

for raw in samples:
    reg = normalize(raw)
    if valid(reg):
        print(raw, "-> VALID")
        print("Receipt:", reg[:2], reg[2:4], reg[4:-4], reg[-4:])
    else:
        print(raw, "-> INVALID")


