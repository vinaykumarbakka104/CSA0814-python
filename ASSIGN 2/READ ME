print("Q6 - STAIRCASE RECURSION")
print("=" * 60)

def ways_naive(n):
    if n <= 1:
        return 1
    return ways_naive(n-1) + ways_naive(n-2)

@lru_cache(None)
def ways_memo(n):
    if n <= 1:
        return 1
    return ways_memo(n-1) + ways_memo(n-2)

def ways_loop(n):
    a, b = 1, 1
    for _ in range(2, n+1):
        a, b = b, a+b
    return b

for n in range(1, 7):
    print("Steps:", n, "Ways:", ways_loop(n))

print("Naive n=20:", ways_naive(20))
print("Memo n=100:", ways_memo(100))
print("Loop n=1000:", ways_loop(1000))


