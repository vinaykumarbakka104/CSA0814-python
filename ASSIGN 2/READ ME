print("Q4 - STRING CONCATENATION VS JOIN")
print("=" * 60)

def build_plus(items):
    result = ""
    for item in items:
        result += item + ";"
    return result

def build_join(items):
    return ";".join(items) + ";"

def build_fstring(n):
    items = [f"Item{i}:Rs{i % 50}" for i in range(n)]
    return ";".join(items) + ";"

def benchmark(n):
    items = [f"Item{i}:Rs{i % 50}" for i in range(n)]
    methods = [
        ("Plus", lambda: build_plus(items)),
        ("Join", lambda: build_join(items)),
        ("F-string", lambda: build_fstring(n))
    ]

    for name, func in methods:
        times = []
        for _ in range(3):
            start = time.perf_counter()
            result = func()
            times.append(time.perf_counter() - start)
        print(name, "Average:", round(mean(times), 5), "sec")

    print("Same output:", build_plus(items) == build_join(items))

for n in (1000, 10000, 200000):
    print("\nItems:", n)
    benchmark(n)


