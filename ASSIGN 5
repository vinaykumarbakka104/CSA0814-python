import sqlite3
import time

# Create database
con = sqlite3.connect(":memory:")
cur = con.cursor()

cur.execute("CREATE TABLE readings(station TEXT, day TEXT, pm25 REAL)")

data = [
    ("Adyar", "2026-10-01", 48),
    ("Guindy", "2026-10-01", 95),
    ("Guindy", "2026-10-03", 121),
    ("Adyar", "2026-10-04", 60)
]

cur.executemany("INSERT INTO readings VALUES(?,?,?)", data)
con.commit()

# B4.1 - Calculate station averages
print("Station averages:")
cur.execute("SELECT station, AVG(pm25) FROM readings GROUP BY station")
print(cur.fetchall())

# B4.2 - Create index and check query
cur.execute("CREATE INDEX idx_readings_station_day ON readings(station, day)")

query = "SELECT AVG(pm25) FROM readings WHERE station='Adyar' AND day>='2026-10-01' AND day<'2026-11-01'"

start = time.time()
cur.execute(query)
print("Adyar average:", cur.fetchone()[0])
print("Query time:", time.time() - start)

# B4.3 - Final decision
print("\nProduction Decision:")
print("SQLite is suitable for small systems.")
print("For large data and many users, use a database server.")
print("Keep raw, cleaned, and error records separately.")

con.close()
