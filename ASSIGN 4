import csv

master = {}
events = {}
errors = []

def validate(line):
    parts = [p.strip() for p in line.strip().split(",")]

    if len(parts) != 5:
        raise ValueError("Expected 5 fields")

    reg, name, dept, email, event_text = parts

    if not reg or not name or not dept:
        raise ValueError("Required fields missing")

    if email.count("@") != 1 or "." not in email.split("@")[1]:
        raise ValueError("Invalid email")

    return reg, name, dept, email, event_text.split(";")

def process_file(filename):
    try:
        with open(filename, "r") as f:
            for line_no, line in enumerate(f, 1):
                if not line.strip():
                    continue

                try:
                    reg, name, dept, email, event_list = validate(line)

                    if reg in master:
                        raise ValueError("Duplicate registration")

                    master[reg] = [name, dept, email, event_list]

                    for event in event_list:
                        event = event.strip()
                        if event:
                            events.setdefault(event, []).append(reg)

                except ValueError as e:
                    errors.append(f"{filename} Line {line_no}: {e}")

    except Exception as e:
        errors.append(f"{filename}: {e}")

# Input files
files = ["cse.txt", "ece.txt", "eee.txt", "mech.txt", "civil.txt"]

for f in files:
    process_file(f)

# Master list
with open("master.csv", "w", newline="") as f:
    w = csv.writer(f)
    w.writerow(["Register", "Name", "Department", "Email", "Events"])
    for reg, data in master.items():
        w.writerow([reg, data[0], data[1], data[2], ";".join(data[3])])

# Event-wise lists
for event, students in events.items():
    with open(event + ".csv", "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["Register Number"])
        w.writerows([[s] for s in students])

# Summary
with open("summary.txt", "w") as f:
    f.write(f"Total Registrations: {len(master)}\n")
    f.write(f"Total Events: {len(events)}\n")

# Error log
with open("errors.txt", "w") as f:
    for error in errors:
        f.write(error + "\n")

print("Registration processing completed!")
print("Accepted:", len(master))
print("Rejected:", len(errors))
